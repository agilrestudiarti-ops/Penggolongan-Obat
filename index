                                <div class="p-2.5 bg-sky-50 rounded-xl text-sky-700 flex items-center justify-center gap-1.5">
                                    <i class="fa-solid fa-leaf"></i> 3 Obat Alam
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Navigation Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div onclick="switchTab('materi')" class="glass-card rounded-2xl p-6 hover:shadow-xl transition duration-300 cursor-pointer border-t-4 border-emerald-500 group">
                    <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-2xl group-hover:scale-110 transition">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <h3 class="font-display text-xl font-bold text-slate-800 mt-4">Materi Interaktif</h3>
                    <p class="text-slate-600 text-sm mt-2">Pelajari simbol warna logo obat bebas, keras, psikotropika hingga herbal dengan visual menarik.</p>
                    <div class="mt-4 text-emerald-600 font-semibold text-sm flex items-center gap-1 group-hover:translate-x-1 transition">
                        Pelajari Sekarang <i class="fa-solid fa-arrow-right"></i>
                    </div>
                </div>

                <!-- Card 2 -->
