        let currentQIndex = 0;
        let score = 0;
        let answered = false;

        function loadQuestion() {
            answered = false;
            const qData = quizQuestions[currentQIndex];
            
            document.getElementById('current-question-num').innerText = currentQIndex + 1;
            document.getElementById('quiz-progress-bar').style.width = ((currentQIndex + 1) / quizQuestions.length * 100) + '%';
            document.getElementById('quiz-question').innerText = qData.q;
            
            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';
            
            document.getElementById('quiz-feedback').classList.add('hidden');
            document.getElementById('next-question-btn').classList.add('hidden');

            qData.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl border-2 border-slate-200 hover:border-emerald-400 hover:bg-emerald-50/50 transition font-medium text-slate-700 text-sm flex items-center justify-between group";
                btn.innerHTML = `<span>${opt}</span> <i class="fa-regular fa-circle text-slate-300 group-hover:text-emerald-500"></i>`;
                btn.onclick = () => selectOption(idx, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function selectOption(selectedIndex, btnElement) {
            if (answered) return;
            answered = true;

            const qData = quizQuestions[currentQIndex];
            const feedbackBox = document.getElementById('quiz-feedback');
            const feedbackText = document.getElementById('feedback-text');
            const nextBtn = document.getElementById('next-question-btn');
            const allOptionBtns = document.getElementById('quiz-options').children;

            if (selectedIndex === qData.correct) {
                score += 10;
                btnElement.classList.remove('border-slate-200');
                btnElement.classList.add('border-emerald-500', 'bg-emerald-100', 'text-emerald-900');
                btnElement.querySelector('i').className = "fa-solid fa-circle-check text-emerald-600 text-lg";

                feedbackBox.className = "p-4 rounded-2xl border text-sm font-medium bg-emerald-50 border-emerald-200 text-emerald-800";
                feedbackText.innerHTML = `<strong>Jawaban Benar!</strong> ${qData.exp}`;
            } else {
                btnElement.classList.remove('border-slate-200');
                btnElement.classList.add('border-rose-500', 'bg-rose-100', 'text-rose-900');
                btnElement.querySelector('i').className = "fa-solid fa-circle-xmark text-rose-600 text-lg";

                // Highlight correct one
                allOptionBtns[qData.correct].classList.remove('border-slate-200');
                allOptionBtns[qData.correct].classList.add('border-emerald-500', 'bg-emerald-50');

                feedbackBox.className = "p-4 rounded-2xl border text-sm font-medium bg-rose-50 border-rose-200 text-rose-800";
                feedbackText.innerHTML = `<strong>Jawaban Kurang Tepat!</strong> ${qData.exp}`;
            }

            feedbackBox.classList.remove('hidden');
            nextBtn.classList.remove('hidden');
        }

        function nextQuestion() {
            currentQIndex++;
            if (currentQIndex < quizQuestions.length) {
                loadQuestion();
            } else {
                showQuizResult();
            }
        }

        function showQuizResult() {
            document.getElementById('quiz-box').classList.add('hidden');
            document.getElementById('quiz-progress-badge').classList.add('hidden');
            document.getElementById('quiz-result').classList.remove('hidden');

            document.getElementById('quiz-score-text').innerText = `${score} / 100`;
            
            let msg = "";
            if (score >= 80) {
                msg = "Luar biasa! Kamu sangat menguasai materi Penggolongan Obat! 🎉";
                confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
            } else if (score >= 60) {
                msg = "Bagus! Pemahamanmu cukup baik, terus tingkatkan lagi ya!";
            } else {
                msg = "Jangan berkecil hati! Pelajari kembali materi dan coba kuis lagi!";
            }
            document.getElementById('quiz-score-message').innerText = msg;
        }

        function restartQuiz() {
            currentQIndex = 0;
            score = 0;
            document.getElementById('quiz-box').classList.remove('hidden');
            document.getElementById('quiz-progress-badge').classList.remove('hidden');
            document.getElementById('quiz-result').classList.add('hidden');
            loadQuestion();
        }

        const dragItemsData = [
            { id: 'item-1', name: 'Parasetamol 500mg', category: 'bebas', bg: 'bg-emerald-100 text-emerald-800 border-emerald-300' },
            { id: 'item-2', name: 'CTM (Chlorpheniramine)', category: 'bebas-terbatas', bg: 'bg-sky-100 text-sky-800 border-sky-300' },
            { id: 'item-3', name: 'Amoksisilin Kaplet', category: 'keras', bg: 'bg-rose-100 text-rose-800 border-rose-300' },
            { id: 'item-4', name: 'Diazepam Tablet', category: 'narkotika', bg: 'bg-purple-100 text-purple-800 border-purple-300' },
            { id: 'item-5', name: 'Jamu Pegal Linu', category: 'tradisional', bg: 'bg-amber-100 text-amber-800 border-amber-300' },
            { id: 'item-6', name: 'Fitofarmaka Stimuno', category: 'tradisional', bg: 'bg-amber-100 text-amber-800 border-amber-300' }
        ];

        let gameScore = 0;
        let selectedTapItem = null;

        function initGame() {
            gameScore = 0;
            document.getElementById('game-score').innerText = gameScore;
            
            const container = document.getElementById('drag-items-container');
            container.innerHTML = '';

            // Reset Drop Zones
            document.querySelectorAll('.zone-items').forEach(el => el.innerHTML = '');

            dragItemsData.forEach(item => {
                const card = document.createElement('div');
                card.id = item.id;
                card.draggable = true;
                card.className = `drag-item px-3 py-2 rounded-xl border text-xs font-bold shadow-sm flex items-center justify-between gap-2 ${item.bg}`;
                card.setAttribute('data-category', item.category);
                card.innerHTML = `<span>${item.name}</span> <i class="fa-solid fa-grip-vertical text-slate-400"></i>`;

                // Drag events
                card.addEventListener('dragstart', handleDragStart);
                // Tap/Click support for mobile accessibility
                card.addEventListener('click', () => handleTapSelect(card));

                container.appendChild(card);
            });

            setupDropZones();
        }

        function handleTapSelect(card) {
            // Unselect previous
            document.querySelectorAll('.drag-item').forEach(el => el.classList.remove('ring-4', 'ring-emerald-400'));
            selectedTapItem = card;
            card.classList.add('ring-4', 'ring-emerald-400');
        }

        function handleDragStart(e) {
            e.dataTransfer.setData('text/plain', e.target.id);
        }

        function setupDropZones() {
            const zones = document.querySelectorAll('.drop-zone');
            
            zones.forEach(zone => {
                zone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    zone.classList.add('drag-over');
                });

                zone.addEventListener('dragleave', () => {
                    zone.classList.remove('drag-over');
                });

                zone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    zone.classList.remove('drag-over');
                    const itemId = e.dataTransfer.getData('text/plain');
                    const itemEl = document.getElementById(itemId);
                    if (itemEl) {
                        validateAndMoveItem(itemEl, zone);
                    }
                });

                // Tap zone to place selected item (Mobile support)
                zone.addEventListener('click', () => {
                    if (selectedTapItem) {
                        validateAndMoveItem(selectedTapItem, zone);
                        selectedTapItem.classList.remove('ring-4', 'ring-emerald-400');
                        selectedTapItem = null;
                    }
                });
            });
        }

        function validateAndMoveItem(itemEl, zone) {
            const itemCategory = itemEl.getAttribute('data-category');
            const zoneCategory = zone.getAttribute('data-category');

            if (itemCategory === zoneCategory) {
                zone.querySelector('.zone-items').appendChild(itemEl);
                itemEl.draggable = false;
                itemEl.className = "px-3 py-1.5 bg-white rounded-lg border border-emerald-300 text-emerald-800 text-xs font-bold shadow-sm flex items-center justify-between";
                itemEl.innerHTML += ` <i class="fa-solid fa-circle-check text-emerald-500"></i>`;
                
                gameScore += 10;
                document.getElementById('game-score').innerText = gameScore;

                if (gameScore === 60) {
                    confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
                }
            } else {
                // Shake animation or visual feedback for wrong zone
                zone.classList.add('border-rose-500', 'bg-rose-50');
                setTimeout(() => {
                    zone.classList.remove('border-rose-500', 'bg-rose-50');
                }, 500);
            }
        }

        function resetGame() {
            initGame();
        }

        window.onload = function() {
            loadQuestion();
            initGame();
        };
    </script>
</body>
</html>