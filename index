                <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-emerald-200/40 rounded-full blur-2xl pointer-events-none"></div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                    <div class="lg:col-span-7 space-y-4">
                        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                            <i class="fa-solid fa-sparkles"></i> Modul Pembelajaran Interaktif
                        </span>
                        <h2 class="font-display text-3xl sm:text-5xl font-bold text-slate-800 leading-tight">
                            Penggolongan <span class="text-emerald-600 underline decoration-emerald-300 decoration-wavy">Obat</span>
                        </h2>
                        <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
                            Selamat datang, calon Tenaga Vokasi Farmasi Indonesia! Mari belajar mengidentifikasi penggolongan obat berdasarkan lingkaran simbol warna, regulasi keamanan, dan tanda peringatan secara interaktif dan menyenangkan.
                        </p>
                        
                        <div class="pt-2 flex flex-wrap gap-3">
                            <button onclick="switchTab('materi')" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl shadow-lg shadow-emerald-600/30 transition hover:-translate-y-0.5 flex items-center gap-2 text-base">
                                <i class="fa-solid fa-play"></i> Mulai Belajar Materi
                            </button>
                            <button onclick="switchTab('dragdrop')" class="px-6 py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-2xl shadow-lg shadow-amber-500/30 transition hover:-translate-y-0.5 flex items-center gap-2 text-base">
                                <i class="fa-solid fa-gamepad"></i> Mainkan Mini Game
                            </button>
                        </div>
                    </div>

                    <!-- Pharmacy Mascot / Visual Illustration -->
                    <div class="lg:col-span-5 flex justify-center">
                        <div class="relative w-full max-w-xs sm:max-w-sm bg-white p-6 rounded-3xl shadow-xl border border-slate-100 text-center space-y-4">
                            <div class="w-24 h-24 mx-auto rounded-full bg-emerald-100 flex items-center justify-center text-4xl text-emerald-600 shadow-inner">
                                <i class="fa-solid fa-mortar-pestle"></i>
                            </div>
                            <div>
                                <h3 class="font-display text-xl font-bold text-slate-800">Siswa SMK Farmasi</h3>
                                <p class="text-xs text-slate-500 mt-1">Siap Menjadi Asisten Tenaga Kefarmasian Handal & Profesional</p>
