    <script>
        function switchTab(tabId) {
            // Hide all tab content
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            // Remove active class from buttons
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

            // Show selected content
            const targetContent = document.getElementById('content-' + tabId);
            if (targetContent) {
                targetContent.classList.remove('hidden');
            }

            // Highlight button
            const targetBtn = document.getElementById('tab-' + tabId);
            if (targetBtn) {
                targetBtn.classList.add('active');
            }

            // Scroll smoothly to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function filterMateri(category) {
            const cards = document.querySelectorAll('.materi-card');
            const btns = document.querySelectorAll('.materi-filter-btn');

            btns.forEach(btn => {
                btn.classList.remove('bg-emerald-600', 'text-white');
                btn.classList.add('bg-slate-100', 'text-slate-700');
            });
            event.target.classList.remove('bg-slate-100', 'text-slate-700');
            event.target.classList.add('bg-emerald-600', 'text-white');

            cards.forEach(card => {
                if (category === 'all' || card.classList.contains(category)) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        const quizQuestions = [
            {
                q: "Apa warna lingkaran simbol logo pada kemasan Obat Bebas?",
                options: ["Biru dengan garis tepi hitam", "Hijau dengan garis tepi hitam tebal", "Merah dengan huruf K", "Putih dengan palang merah"],
                correct: 1,
                exp: "Obat Bebas ditandai dengan lingkaran berwarna hijau dengan garis tepi tebal berwarna hitam."
            },
            {
                q: "Tanda peringatan P.No. 1 pada obat bebas terbatas berbunyi...",
                options: ["Awas! Obat Keras. Hanya untuk dibakar", "Awas! Obat Keras. Baca aturan pakainya", "Awas! Obat Keras. Hanya untuk kumur", "Awas! Obat Keras. Obat Wasir"],
                correct: 1,
                exp: "P.No. 1 berisi peringatan: 'Awas! Obat Keras. Baca aturan pakainya'."
            },
            {
                q: "Huruf apakah yang terdapat di dalam lingkaran merah logo Obat Keras?",
                options: ["Huruf O", "Huruf P", "Huruf K", "Huruf B"],
                correct: 2,
                exp: "Obat Keras ditandai dengan lingkaran merah, garis tepi hitam, dan huruf K berwarna hitam di tengah."
            },
            {
                q: "Obat herbal berbahan alam yang telah dibuktikan keamanannya melalui Uji Klinik pada manusia dinamakan...",
                options: ["Jamu", "Obat Herbal Terstandar (OHT)", "Fitofarmaka", "Obat Tradisional Bebas"],
                correct: 2,
                exp: "Fitofarmaka adalah derajat tertinggi obat bahan alam yang telah melewati uji pra-klinik dan uji klinik pada manusia."
            },
            {
                q: "Contoh obat yang tergolong ke dalam kelompok Obat Bebas adalah...",
                options: ["Amoksisilin", "Parasetamol", "Diazepam", "CTM"],
                correct: 1,
                exp: "Parasetamol dapat dibeli secara bebas tanpa resep dokter di apotek maupun toko obat berizin."
            },
            {
                q: "Golongan obat yang mempengaruhi sistem saraf pusat dan menyebabkan perubahan khas pada aktivitas mental adalah...",
                options: ["Obat Bebas", "Psikotropika & Narkotika", "Jamu", "Obat Bebas Terbatas"],
                correct: 1,
                exp: "Psikotropika dan Narkotika bekerja pada sistem saraf pusat dan penggunaannya diawasi ketat."
            },
            {
                q: "Tanda peringatan P.No. 2 'Hanya untuk kumur, jangan ditelan' biasanya ditemukan pada...",
                options: ["Obat tetes mata", "Obat kumur antiseptik mengandung bahan keras", "Salep kulit", "Obat cacing"],
                correct: 1,
                exp: "P.No 2 dicantumkan pada obat kumur yang mengandung obat keras agar tidak tertelan."
            },
            {
                q: "Logo Obat Herbal Terstandar (OHT) digambarkan dengan simbol berupa...",
                options: ["Jari-jari daun", "3 pasang bintang hijau", "Kristal es / salju", "Palang merah"],
                correct: 1,
                exp: "Obat Herbal Terstandar (OHT) memiliki logo berupa 3 pasang bintang berwarna hijau."
            },
            {
                q: "Obat mana berikut yang pembeliannya HARUS menggunakan resep dokter?",
                options: ["Antasida Doen", "Vitamin C", "Amoksisilin (Antibiotik)", "Minyak Kayu Putih"],
                correct: 2,
                exp: "Amoksisilin adalah antibiotik (Obat Keras) yang wajib dibeli menggunakan resep dokter."
            },
            {
                q: "Tanda peringatan P.No. 6 berisi pesan khusus untuk...",
                options: ["Obat gosok", "Obat wasir, jangan ditelan", "Obat tetes hidung", "Obat salep mata"],
