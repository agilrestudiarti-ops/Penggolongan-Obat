        <!-- TAB 3: MATERI -->
        <section id="content-materi" class="tab-content hidden fade-in space-y-6">
            <!-- Header Section Materi -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-3xl shadow-md border border-slate-200">
