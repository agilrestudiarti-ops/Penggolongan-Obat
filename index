                    <button onclick="switchTab('kuis')" id="tab-kuis" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-100/50 transition-all duration-200 flex items-center gap-2">
                        <i class="fa-solid fa-clipboard-question"></i> Kuis Interaktif
                    </button>
                    <button onclick="switchTab('dragdrop')" id="tab-dragdrop" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-100/50 transition-all duration-200 flex items-center gap-2">
                        <i class="fa-solid fa-puzzle-piece"></i> Drag & Drop Game
                    </button>
                    <button onclick="switchTab('tentang')" id="tab-tentang" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-100/50 transition-all duration-200 flex items-center gap-2">
                        <i class="fa-solid fa-circle-info"></i> Tentang
                    </button>
                </div>
            </div>
