                <div class="materi-card kimia glass-card rounded-2xl p-5 hover:shadow-xl transition border-2 border-purple-400 relative">
                    <div class="flex items-center justify-between">
                        <span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-full">KONTROL KETAT</span>
                        <!-- Logo Visual Narkotika (Palang Merah) -->
                        <div class="w-10 h-10 rounded-full bg-white border-2 border-rose-600 flex items-center justify-center text-rose-600 font-bold text-2xl shadow">
                            +
                        </div>
                    </div>
