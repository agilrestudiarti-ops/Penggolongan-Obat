                    <button onclick="switchTab('materi')" id="tab-materi" class="tab-btn px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:text-emerald-700 hover:bg-emerald-100/50 transition-all duration-200 flex items-center gap-2">
                        <i class="fa-solid fa-book-medical"></i> Materi
